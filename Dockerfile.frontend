# =============================================================================
# Dockerfile.frontend — React/Vite + Nginx
# Build estático servido por nginx de alta performance
# =============================================================================

# ── Stage 1: Build do React ──────────────────────────────────────────────────
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /workspace

# Copia manifests do workspace (cache de layer)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./

# Copia package.json dos pacotes que o dashboard depende
COPY artifacts/saas-dashboard/package.json    ./artifacts/saas-dashboard/
COPY lib/api-client-react/package.json        ./lib/api-client-react/
COPY lib/api-spec/package.json                ./lib/api-spec/
COPY lib/api-zod/package.json                 ./lib/api-zod/

# Instala dependências do dashboard e das libs transitivas
RUN pnpm install --frozen-lockfile --filter @workspace/saas-dashboard...

# Copia código-fonte do dashboard e das libs
COPY artifacts/saas-dashboard ./artifacts/saas-dashboard
COPY lib ./lib
COPY tsconfig.base.json tsconfig.json ./

# Build de produção (Vite)
# PORT e BASE_PATH são necessários pelo vite.config.ts durante o build
ENV PORT=80 BASE_PATH=/
RUN cd artifacts/saas-dashboard && pnpm run build

# ── Stage 2: Nginx ───────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

# Remove config padrão do nginx
RUN rm /etc/nginx/conf.d/default.conf

# Copia config customizada
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf

# Copia arquivos estáticos do build
COPY --from=builder /workspace/artifacts/saas-dashboard/dist/public /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
