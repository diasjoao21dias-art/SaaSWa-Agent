# =============================================================================
# Dockerfile.api — NestJS API + BullMQ Workers
# Multi-stage build para produção mínima (~200 MB final)
# =============================================================================

# ── Stage 1: Dependências ────────────────────────────────────────────────────
FROM node:20-alpine AS deps

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /workspace

# Copia os manifests do workspace primeiro (melhor cache de layers)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./

# Copia apenas o package.json do api-server (não o código ainda)
COPY artifacts/api-server/package.json ./artifacts/api-server/

# Instala somente as dependências do api-server e suas transitivas
RUN pnpm install --frozen-lockfile --filter @workspace/api-server...

# ── Stage 2: Build ───────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /workspace

# Reutiliza node_modules do stage anterior
COPY --from=deps /workspace/node_modules ./node_modules
COPY --from=deps /workspace/artifacts/api-server/node_modules ./artifacts/api-server/node_modules

# Copia o código-fonte completo do api-server
COPY artifacts/api-server ./artifacts/api-server
COPY package.json pnpm-workspace.yaml ./

# Gera o Prisma Client (necessário antes de compilar)
RUN cd artifacts/api-server && \
    ../../node_modules/.bin/prisma generate --schema=./prisma/schema.prisma

# Compila TypeScript → JavaScript com SWC
RUN cd artifacts/api-server && \
    ../../node_modules/.bin/swc src \
      --out-dir dist \
      --strip-leading-paths \
      --config-file .swcrc

# ── Stage 3: Produção ────────────────────────────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

# Copia o client pnpm para rodar scripts de migration
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copia apenas o necessário para rodar em produção
COPY --from=builder /workspace/node_modules            ./node_modules
COPY --from=builder /workspace/artifacts/api-server/dist  ./dist
COPY --from=builder /workspace/artifacts/api-server/prisma ./prisma
COPY --from=builder /workspace/artifacts/api-server/package.json ./package.json

# Usuário não-root para segurança
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

EXPOSE 3000

# Aplica migrations pendentes e sobe o servidor
CMD ["sh", "-c", \
  "node_modules/.bin/prisma migrate deploy --schema=./prisma/schema.prisma && node dist/main.js"]
