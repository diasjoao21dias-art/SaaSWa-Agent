# Base44 dev defaults — placeholders so the app boots without external credentials.
# Real secrets delivered via /run/base44/app.env override these.

NODE_ENV=development

# ── PostgreSQL (local infra) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres_base44_dev@postgres:5432/whatsapp_saas?schema=public

# ── Redis (local infra) ───────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_base44_dev

# ── JWT (local dev secrets) ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=base44_dev_access_secret_min_32_chars_long_xxx
JWT_REFRESH_SECRET=base44_dev_refresh_secret_min_32_chars_long_xx

# ── OpenAI (optional in dev — placeholder) ────────────────────────────────────
OPENAI_API_KEY=sk-dev-placeholder

# ── Evolution API (optional in dev — placeholder) ──────────────────────────────
EVOLUTION_API_BASE_URL=http://localhost:8888
EVOLUTION_API_KEY=dev-placeholder-key
EVOLUTION_WEBHOOK_SECRET=dev-placeholder-secret-32chars

# ── App ───────────────────────────────────────────────────────────────────────
APP_PUBLIC_URL=http://localhost:3000
APP_ALLOWED_ORIGINS=*
APP_GLOBAL_PREFIX=api
