# =============================================================================
# WhatsApp AI SaaS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_GLOBAL_PREFIX=api
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_ai_saas

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DB=0

# ─── JWT (min 32 chars each) ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-super-secret-access-token-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_ORGANIZATION=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000

# ─── Evolution API ────────────────────────────────────────────────────────────
EVOLUTION_API_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_WEBHOOK_SECRET=your-webhook-hmac-secret-min-16-chars
