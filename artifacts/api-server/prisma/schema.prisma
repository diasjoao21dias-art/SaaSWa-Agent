// =============================================================================
// PRISMA SCHEMA — WhatsApp AI SaaS Multi-Tenant
// Senior DBA Design | PostgreSQL | Clean Architecture
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), pgcrypto, vector]
}

// =============================================================================
// ENUMS
// =============================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELED
  PENDING_SETUP
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  BLOCKED
}

enum WhatsappNumberStatus {
  CONNECTED
  DISCONNECTED
  QR_CODE
  INITIALIZING
  ERROR
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum PromptType {
  SYSTEM
  USER
  FEW_SHOT
  INSTRUCTION
  CONTEXT
}

enum KnowledgeBaseType {
  FAQ
  DOCUMENT
  URL
  MANUAL
  DATABASE
}

enum KnowledgeDocumentStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

enum FileStorageProvider {
  S3
  GCS
  AZURE_BLOB
  LOCAL
}

enum FileStatus {
  UPLOADING
  READY
  PROCESSING
  ERROR
  DELETED
}

enum ConversationStatus {
  BOT
  HUMAN
  WAITING
  CLOSED
  ARCHIVED
}

enum ConversationChannel {
  WHATSAPP
  INSTAGRAM
  TELEGRAM
  EMAIL
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  HUMAN
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  STICKER
  REACTION
  TEMPLATE
  INTERACTIVE
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  DELETED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  INCOMPLETE
}

enum IntegrationType {
  EVOLUTION_API
  OPENAI
  ANTHROPIC
  STRIPE
  ASAAS
  WEBHOOK_OUTBOUND
  ZAPIER
  HUBSPOT
  PIPEDRIVE
  SLACK
  GOOGLE_SHEETS
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
  PENDING_SETUP
}

enum IntegrationLogDirection {
  INBOUND
  OUTBOUND
}

enum WebhookStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

enum TokenType {
  REFRESH
  API_KEY
  INVITE
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  EXPORT
  IMPORT
  INVITE
  REVOKE
  ENABLE
  DISABLE
  UPGRADE
  DOWNGRADE
  CANCEL
}

enum AuditActorType {
  USER
  SYSTEM
  API_KEY
  WEBHOOK
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
  ALERT
}

enum PermissionScope {
  GLOBAL
  TENANT
}

enum BillingInterval {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum AttendanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELED
  TRANSFERRED
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
  REFUND
}

enum FinancialTransactionStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
  REFUNDED
}

// =============================================================================
// TENANTS — Empresas
// =============================================================================

model Tenant {
  id         String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String       @db.VarChar(255)
  slug       String       @unique @db.VarChar(100)
  document   String?      @db.VarChar(30) // CNPJ / CPF
  email      String       @db.VarChar(255)
  phone      String?      @db.VarChar(30)
  website    String?      @db.VarChar(500)
  logoFileId String?      @map("logo_file_id") @db.Uuid
  status     TenantStatus @default(TRIAL)
  timezone   String       @default("America/Sao_Paulo") @db.VarChar(60)
  locale     String       @default("pt-BR") @db.VarChar(10)
  settings   Json         @default("{}") @db.JsonB
  metadata   Json         @default("{}") @db.JsonB
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?    @map("deleted_at") @db.Timestamptz(6)

  // Relations
  users                 User[]
  customers             Customer[]
  whatsappNumbers       WhatsappNumber[]
  aiAgents              AiAgent[]
  prompts               Prompt[]
  knowledgeBases        KnowledgeBase[]
  files                 File[]
  conversations         Conversation[]
  subscriptions         Subscription[]
  usageMetrics          UsageMetric[]
  integrations          Integration[]
  webhooks              Webhook[]
  tokens                Token[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  tags                  Tag[]
  roles                 Role[]
  attendances           Attendance[]
  financialTransactions FinancialTransaction[]
  logoFile              File?                  @relation("TenantLogo", fields: [logoFileId], references: [id])

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@map("tenants")
}

// =============================================================================
// ROLES — Papéis de Acesso
// =============================================================================

model Role {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @db.VarChar(100)
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole_[]
  rolePerms RolePermission[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

// =============================================================================
// PERMISSIONS — Permissões Granulares
// =============================================================================

model Permission {
  id          String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key         String          @unique @db.VarChar(100) // e.g. "conversations:read"
  name        String          @db.VarChar(150)
  description String?         @db.Text
  scope       PermissionScope @default(TENANT)
  group       String          @db.VarChar(50) // e.g. "conversations", "agents"
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(6)

  rolePerms RolePermission[]
  userPerms UserPermission[]

  @@index([group])
  @@index([scope])
  @@map("permissions")
}

// =============================================================================
// USER_ROLES — Pivot Users ↔ Roles
// =============================================================================

model UserRole_ {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  grantedById String?   @map("granted_by_id") @db.Uuid
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("GrantedByUser", fields: [grantedById], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// =============================================================================
// ROLE_PERMISSIONS — Pivot Roles ↔ Permissions
// =============================================================================

model RolePermission {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// =============================================================================
// USER_PERMISSIONS — Permissões Diretas no Usuário (bypass de role)
// =============================================================================

model UserPermission {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  grantedById  String?   @map("granted_by_id") @db.Uuid
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("GrantedByUserPerm", fields: [grantedById], references: [id])

  @@unique([userId, permissionId])
  @@index([userId])
  @@map("user_permissions")
}

// =============================================================================
// USERS — Usuários do Painel
// =============================================================================

model User {
  id              String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  email           String     @db.VarChar(255)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  name            String     @db.VarChar(255)
  avatarFileId    String?    @map("avatar_file_id") @db.Uuid
  phone           String?    @db.VarChar(30)
  role            UserRole   @default(AGENT)
  status          UserStatus @default(INVITED)
  /// Grants platform-level superadmin privileges (manage all tenants and plans).
  /// Completely independent of the tenant-scoped UserRole hierarchy.
  /// Set via `prisma/seed-superadmin.ts` — never exposed on registration endpoints.
  isSuperAdmin    Boolean    @default(false) @map("is_super_admin")
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp     String?    @map("last_login_ip") @db.VarChar(45)
  invitedById     String?    @map("invited_by_id") @db.Uuid
  invitedAt       DateTime?  @map("invited_at") @db.Timestamptz(6)
  metadata        Json       @default("{}") @db.JsonB
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  avatarFile          File?                 @relation("UserAvatar", fields: [avatarFileId], references: [id])
  invitedBy           User?                 @relation("InvitedUsers", fields: [invitedById], references: [id])
  invitedUsers        User[]                @relation("InvitedUsers")
  userRoles           UserRole_[]
  grantedRoles        UserRole_[]           @relation("GrantedByUser")
  userPermissions     UserPermission[]
  grantedPermissions  UserPermission[]      @relation("GrantedByUserPerm")
  tokens              Token[]
  auditLogs           AuditLog[]            @relation("AuditActor")
  notifications       Notification[]
  conversations       Conversation[]        @relation("HumanOperator")
  messages            Message[]             @relation("HumanMessage")
  promptVersions      PromptVersion[]
  files               File[]                @relation("UploadedBy")
  subscriptionHistory SubscriptionHistory[]
  attendances         Attendance[]          @relation("AttendanceOperator")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

// =============================================================================
// TAGS — Etiquetas de Organização
// =============================================================================

model Tag {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(60)
  color       String    @default("#6366f1") @db.VarChar(7)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerTags     CustomerTag[]
  conversationTags ConversationTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tags")
}

// =============================================================================
// CUSTOMERS — Clientes Finais (Contatos do WhatsApp)
// =============================================================================

model Customer {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  phone         String    @db.VarChar(30)
  name          String?   @db.VarChar(255)
  email         String?   @db.VarChar(255)
  avatarUrl     String?   @map("avatar_url") @db.VarChar(500)
  notes         String?   @db.Text
  isBlocked     Boolean   @default(false) @map("is_blocked")
  blockedAt     DateTime? @map("blocked_at") @db.Timestamptz(6)
  blockedReason String?   @map("blocked_reason") @db.Text
  customFields  Json      @default("{}") @map("custom_fields") @db.JsonB
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations         Conversation[]
  customerTags          CustomerTag[]
  attendances           Attendance[]
  financialTransactions FinancialTransaction[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([phone])
  @@index([tenantId, isBlocked])
  @@index([deletedAt])
  @@map("customers")
}

// =============================================================================
// CUSTOMER_TAGS — Pivot Customers ↔ Tags
// =============================================================================

model CustomerTag {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  tagId      String    @map("tag_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([customerId, tagId])
  @@index([customerId])
  @@index([tagId])
  @@map("customer_tags")
}

// =============================================================================
// WHATSAPP_NUMBERS — Números de WhatsApp Conectados
// =============================================================================

model WhatsappNumber {
  id              String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  agentId         String?              @map("agent_id") @db.Uuid
  instanceName    String               @unique @map("instance_name") @db.VarChar(255)
  phoneNumber     String?              @map("phone_number") @db.VarChar(30)
  displayName     String?              @map("display_name") @db.VarChar(255)
  status          WhatsappNumberStatus @default(DISCONNECTED)
  qrCode          String?              @map("qr_code") @db.Text
  qrCodeExpiresAt DateTime?            @map("qr_code_expires_at") @db.Timestamptz(6)
  sessionData     Json                 @default("{}") @map("session_data") @db.JsonB
  webhookSecret   String?              @map("webhook_secret") @db.VarChar(255)
  lastConnectedAt DateTime?            @map("last_connected_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?            @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent         AiAgent?       @relation(fields: [agentId], references: [id])
  conversations Conversation[]

  @@index([tenantId])
  @@index([instanceName])
  @@index([tenantId, status])
  @@index([deletedAt])
  @@map("whatsapp_numbers")
}

// =============================================================================
// KNOWLEDGE_BASES — Bases de Conhecimento
// =============================================================================

model KnowledgeBase {
  id             String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  name           String            @db.VarChar(255)
  description    String?           @db.Text
  type           KnowledgeBaseType @default(MANUAL)
  embeddingModel String            @default("text-embedding-3-small") @map("embedding_model") @db.VarChar(100)
  isActive       Boolean           @default(true) @map("is_active")
  metadata       Json              @default("{}") @db.JsonB
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents KnowledgeDocument[]
  agents    AiAgent[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([deletedAt])
  @@map("knowledge_bases")
}

// =============================================================================
// KNOWLEDGE_DOCUMENTS — Documentos da Base de Conhecimento
// =============================================================================

model KnowledgeDocument {
  id              String                       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  knowledgeBaseId String                       @map("knowledge_base_id") @db.Uuid
  fileId          String?                      @map("file_id") @db.Uuid
  title           String                       @db.VarChar(500)
  content         String                       @db.Text
  question        String?                      @db.Text // Para tipo FAQ
  answer          String?                      @db.Text // Para tipo FAQ
  sourceUrl       String?                      @map("source_url") @db.VarChar(2000)
  embedding       Unsupported("vector(1536)")? // Vetor de embedding (pgvector)
  chunkIndex      Int                          @default(0) @map("chunk_index")
  tokenCount      Int                          @default(0) @map("token_count")
  status          KnowledgeDocumentStatus      @default(PENDING)
  errorMessage    String?                      @map("error_message") @db.Text
  processedAt     DateTime?                    @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?                    @map("deleted_at") @db.Timestamptz(6)

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  file          File?         @relation(fields: [fileId], references: [id])

  @@index([knowledgeBaseId])
  @@index([knowledgeBaseId, status])
  @@index([deletedAt])
  @@map("knowledge_documents")
}

// =============================================================================
// FILES — Arquivos e Mídias
// =============================================================================

model File {
  id              String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  uploadedById    String?             @map("uploaded_by_id") @db.Uuid
  storageProvider FileStorageProvider @default(S3) @map("storage_provider")
  storageKey      String              @map("storage_key") @db.VarChar(2000)
  publicUrl       String?             @map("public_url") @db.VarChar(2000)
  originalName    String              @map("original_name") @db.VarChar(500)
  mimeType        String              @map("mime_type") @db.VarChar(255)
  sizeBytes       BigInt              @map("size_bytes")
  width           Int?
  height          Int?
  duration        Int? // segundos (para áudio/vídeo)
  checksum        String?             @db.VarChar(64) // SHA-256
  status          FileStatus          @default(UPLOADING)
  metadata        Json                @default("{}") @db.JsonB
  expiresAt       DateTime?           @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy         User?               @relation("UploadedBy", fields: [uploadedById], references: [id])
  messages           Message[]
  knowledgeDocuments KnowledgeDocument[]
  tenantLogos        Tenant[]            @relation("TenantLogo")
  userAvatars        User[]              @relation("UserAvatar")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([storageKey])
  @@index([deletedAt])
  @@map("files")
}

// =============================================================================
// PROMPTS — Biblioteca de Prompts
// =============================================================================

model Prompt {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  title       String     @db.VarChar(255)
  description String?    @db.Text
  content     String     @db.Text
  type        PromptType @default(SYSTEM)
  version     Int        @default(1)
  isActive    Boolean    @default(true) @map("is_active")
  variables   Json       @default("[]") @db.JsonB // Variáveis disponíveis no template
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agents   AiAgent[]
  versions PromptVersion[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([deletedAt])
  @@map("prompts")
}

// =============================================================================
// PROMPT_VERSIONS — Histórico de Versões de Prompts
// =============================================================================

model PromptVersion {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  promptId    String    @map("prompt_id") @db.Uuid
  createdById String?   @map("created_by_id") @db.Uuid
  version     Int
  content     String    @db.Text
  changeNote  String?   @map("change_note") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  prompt    Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id])

  @@unique([promptId, version])
  @@index([promptId])
  @@map("prompt_versions")
}

// =============================================================================
// AI_AGENTS — Agentes de Inteligência Artificial
// =============================================================================

model AiAgent {
  id                  String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId            String      @map("tenant_id") @db.Uuid
  promptId            String?     @map("prompt_id") @db.Uuid
  knowledgeBaseId     String?     @map("knowledge_base_id") @db.Uuid
  name                String      @db.VarChar(255)
  description         String?     @db.Text
  avatarUrl           String?     @map("avatar_url") @db.VarChar(500)
  model               String      @default("gpt-4o-mini") @db.VarChar(100)
  temperature         Float       @default(0.7)
  maxTokens           Int         @default(1024) @map("max_tokens")
  topP                Float       @default(1.0) @map("top_p")
  presencePenalty     Float       @default(0.0) @map("presence_penalty")
  frequencyPenalty    Float       @default(0.0) @map("frequency_penalty")
  contextWindowSize   Int         @default(10) @map("context_window_size") // Mensagens de histórico a incluir
  welcomeMessage      String?     @map("welcome_message") @db.Text
  fallbackMessage     String?     @map("fallback_message") @db.Text
  status              AgentStatus @default(DRAFT)
  humanHandoffEnabled Boolean     @default(true) @map("human_handoff_enabled")
  handoffKeywords     String[]    @map("handoff_keywords") @db.Text
  inactivityTimeout   Int         @default(60) @map("inactivity_timeout") // minutos
