  deletedAt           DateTime?   @map("deleted_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prompt          Prompt?          @relation(fields: [promptId], references: [id])
  knowledgeBase   KnowledgeBase?   @relation(fields: [knowledgeBaseId], references: [id])
  whatsappNumbers WhatsappNumber[]
  conversations   Conversation[]
  attendances     Attendance[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([deletedAt])
  @@map("ai_agents")
}

// =============================================================================
// CONVERSATIONS — Conversas
// =============================================================================

model Conversation {
  id               String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  customerId       String              @map("customer_id") @db.Uuid
  whatsappNumberId String              @map("whatsapp_number_id") @db.Uuid
  agentId          String?             @map("agent_id") @db.Uuid
  humanOperatorId  String?             @map("human_operator_id") @db.Uuid
  externalId       String?             @map("external_id") @db.VarChar(255) // ID externo (Evolution API)
  status           ConversationStatus  @default(BOT)
  channel          ConversationChannel @default(WHATSAPP)
  subject          String?             @db.VarChar(500)
  rating           Int? // 1-5 estrelas
  ratingNote       String?             @map("rating_note") @db.Text
  resolutionNotes  String?             @map("resolution_notes") @db.Text
  firstMessageAt   DateTime?           @map("first_message_at") @db.Timestamptz(6)
  lastMessageAt    DateTime?           @map("last_message_at") @db.Timestamptz(6)
  humanAssignedAt  DateTime?           @map("human_assigned_at") @db.Timestamptz(6)
  closedAt         DateTime?           @map("closed_at") @db.Timestamptz(6)
  metadata         Json                @default("{}") @db.JsonB
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?           @map("deleted_at") @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id])
  whatsappNumber   WhatsappNumber    @relation(fields: [whatsappNumberId], references: [id])
  agent            AiAgent?          @relation(fields: [agentId], references: [id])
  humanOperator    User?             @relation("HumanOperator", fields: [humanOperatorId], references: [id])
  messages         Message[]
  conversationTags ConversationTag[]
  attendances      Attendance[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, lastMessageAt])
  @@index([customerId, status])
  @@index([whatsappNumberId])
  @@index([humanOperatorId])
  @@index([externalId])
  @@index([deletedAt])
  @@map("conversations")
}

// =============================================================================
// CONVERSATION_TAGS — Pivot Conversations ↔ Tags
// =============================================================================

model ConversationTag {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  tagId          String    @map("tag_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([conversationId, tagId])
  @@index([conversationId])
  @@index([tagId])
  @@map("conversation_tags")
}

// =============================================================================
// MESSAGES — Mensagens
// =============================================================================

model Message {
  id                String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conversationId    String        @map("conversation_id") @db.Uuid
  fileId            String?       @map("file_id") @db.Uuid
  sentByUserId      String?       @map("sent_by_user_id") @db.Uuid
  whatsappMessageId String?       @map("whatsapp_message_id") @db.VarChar(255) // ID externo
  role              MessageRole   @default(USER)
  type              MessageType   @default(TEXT)
  content           String?       @db.Text
  caption           String?       @db.Text // Legenda de mídia
  status            MessageStatus @default(PENDING)
  tokensInput       Int           @default(0) @map("tokens_input")
  tokensOutput      Int           @default(0) @map("tokens_output")
  processingTimeMs  Int?          @map("processing_time_ms")
  aiModel           String?       @map("ai_model") @db.VarChar(100)
  errorMessage      String?       @map("error_message") @db.Text
  sentAt            DateTime?     @map("sent_at") @db.Timestamptz(6)
  deliveredAt       DateTime?     @map("delivered_at") @db.Timestamptz(6)
  readAt            DateTime?     @map("read_at") @db.Timestamptz(6)
  metadata          Json          @default("{}") @db.JsonB
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  file         File?        @relation(fields: [fileId], references: [id])
  sentByUser   User?        @relation("HumanMessage", fields: [sentByUserId], references: [id])

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([conversationId, role])
  @@index([whatsappMessageId])
  @@index([status])
  @@index([deletedAt])
  @@map("messages")
}

// =============================================================================
// PLANS — Planos de Assinatura
// =============================================================================

model Plan {
  id               String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name             String          @db.VarChar(100)
  slug             String          @unique @db.VarChar(50)
  description      String?         @db.Text
  priceMonthly     Decimal         @map("price_monthly") @db.Decimal(10, 2)
  priceYearly      Decimal         @map("price_yearly") @db.Decimal(10, 2)
  currency         String          @default("BRL") @db.VarChar(3)
  trialDays        Int             @default(14) @map("trial_days")
  billingInterval  BillingInterval @default(MONTHLY) @map("billing_interval")
  isActive         Boolean         @default(true) @map("is_active")
  isPublic         Boolean         @default(true) @map("is_public")
  sortOrder        Int             @default(0) @map("sort_order")
  // Limites
  maxWhatsappNums  Int             @default(1) @map("max_whatsapp_numbers")
  maxAgents        Int             @default(1) @map("max_agents")
  maxUsers         Int             @default(3) @map("max_users")
  maxConvMonth     Int             @default(500) @map("max_conversations_per_month")
  maxMsgDay        Int             @default(1000) @map("max_messages_per_day")
  maxKnowledgeDocs Int             @default(100) @map("max_knowledge_documents")
  maxStorageGb     Int             @default(1) @map("max_storage_gb")
  // Feature flags
  features         String[]        @db.Text
  aiModelsAllowed  String[]        @map("ai_models_allowed") @db.Text
  metadata         Json            @default("{}") @db.JsonB
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(6)

  subscriptions         Subscription[]
  subscriptionHistory   SubscriptionHistory[]
  financialTransactions FinancialTransaction[]

  @@index([isActive, isPublic])
  @@index([slug])
  @@map("plans")
}

// =============================================================================
// SUBSCRIPTIONS — Assinaturas
// =============================================================================

model Subscription {
  id                 String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(TRIAL)
  externalId         String?            @map("external_id") @db.VarChar(255) // ID no gateway de pagamento
  externalCustomerId String?            @map("external_customer_id") @db.VarChar(255)
  paymentMethod      Json               @default("{}") @map("payment_method") @db.JsonB
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart DateTime?          @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime?          @map("canceled_at") @db.Timestamptz(6)
  cancelReason       String?            @map("cancel_reason") @db.Text
  metadata           Json               @default("{}") @db.JsonB
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
