modules = ["nodejs-20", "web", "bash", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/saas-dashboard: web"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/saas-dashboard: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=25543 BASE_PATH=/ pnpm --filter @workspace/saas-dashboard run dev"
waitForPort = 25543

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
APP_PUBLIC_URL = "https://45cac0a9-7ce7-4ea7-9b97-f34919897915-00-33un003drhiwf.picard.replit.dev/api"
REDIS_PORT = "6379"
APP_ALLOWED_ORIGINS = "*"
APP_GLOBAL_PREFIX = "api"
JWT_ACCESS_EXPIRATION = "15m"
JWT_REFRESH_EXPIRATION = "7d"
NODE_ENV = "development"
OPENAI_DEFAULT_MODEL = "gpt-4o-mini"
REDIS_DB = "0"
REDIS_HOST = "localhost"
REDIS_TLS = "false"
EVOLUTION_API_BASE_URL = "http://localhost:8888"
EVOLUTION_API_KEY = "dev-placeholder-key"
EVOLUTION_WEBHOOK_SECRET = "dev-placeholder-secret-32chars"
