# =============================================================================
# .env.example — Variáveis de ambiente
#
# Copie para .env e preencha os valores antes de rodar o docker-compose:
#   cp .env.example .env
#
# NUNCA faça commit do .env com valores reais.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=whatsapp_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password

# URL completa usada pelo Prisma (gerada a partir das vars acima)
DATABASE_URL=postgresql://postgres:change_me_postgres_password@postgres:5432/whatsapp_saas?schema=public

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Evolution API (WhatsApp Gateway) ─────────────────────────────────────────
# URL pública onde o Evolution API fica acessível (via nginx ou domínio)
EVOLUTION_API_BASE_URL=http://nginx/evolution

# Chave de autenticação da Evolution API (defina também em EVOLUTION_API_KEY abaixo)
EVOLUTION_API_KEY=change_me_evolution_api_key

# Secret usado para validar assinaturas dos webhooks recebidos da Evolution API
EVOLUTION_WEBHOOK_SECRET=change_me_evolution_webhook_secret

# ── App ───────────────────────────────────────────────────────────────────────
# URL pública do backend (usada para registrar webhook URLs na Evolution API)
APP_PUBLIC_URL=http://localhost/api

NODE_ENV=production
PORT=3000
